<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon is the only thing pulled from WinForms; WPF has no tray API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>VolumeX</AssemblyName>
    <RootNamespace>Crescendo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\volumex.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.6</Version>
    <Product>VolumeX</Product>
    <Company>Ferhad</Company>
    <Description>System-wide audio amplification with clipping protection.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- Warnings stay loud: this app runs DSP-adjacent interop where a silent
         null or a wrong marshalling attribute is an audio glitch, not a typo. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- WFAC010 is a WinForms-only DPI hint; this is a WPF app that uses
         WinForms solely for NotifyIcon, and WPF reads DPI from the manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencing WinForms for the tray icon drags System.Drawing and
         System.Windows.Forms into every file's implicit usings, where Brush,
         Point, MouseEventArgs and friends collide with their WPF namesakes.
         The two files that genuinely need WinForms import it explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mark, embedded so the window and the tray icon load it without
         depending on files next to the executable. -->
    <Resource Include="..\..\assets\volumex.ico">
      <Link>volumex.ico</Link>
    </Resource>
    <Resource Include="..\..\assets\volumex-256.png">
      <Link>volumex.png</Link>
    </Resource>
    <Resource Include="..\..\assets\volumex-wordmark-560.png">
      <Link>volumex-wordmark.png</Link>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <!-- The native engine ships beside the executable; EngineService copies it
         into Program Files during install, where audiodg.exe can load it. -->
    <None Include="$(MSBuildProjectDirectory)\..\..\artifacts\CrescendoApo.dll"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\artifacts\CrescendoApo.dll')">
      <Link>CrescendoApo.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
