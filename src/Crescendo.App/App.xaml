<Application x:Class="Crescendo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Crescendo"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped at runtime by ThemeService; everything else
                     resolves colours through DynamicResource so the exchange
                     re-themes the live window. -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:PresenceToVisibilityConverter x:Key="PresenceToVisibility" />
            <local:EnumEqualsConverter x:Key="EnumEquals" />
            <local:ScaleConverter x:Key="Scale" />
            <local:EqualityMultiConverter x:Key="ReferenceEqual" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
