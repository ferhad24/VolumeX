<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette.

        Not the dark palette inverted. Elevation in light mode comes from a warm
        white sitting on a cool grey field rather than from lightness steps, and
        the accent is darkened to keep contrast against white above 4.5:1 — the
        aqua that reads as vivid on near-black is illegible on a light card.
    -->

    <Color x:Key="BaseColor">#FFF1F4F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="ElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="OverlayColor">#FFF7F9FC</Color>
    <Color x:Key="BorderColor">#FFE1E6EF</Color>
    <Color x:Key="BorderStrongColor">#FFC9D1DF</Color>

    <Color x:Key="TextPrimaryColor">#FF0E1420</Color>
    <Color x:Key="TextSecondaryColor">#FF56617A</Color>
    <Color x:Key="TextTertiaryColor">#FF8A93A6</Color>

    <Color x:Key="AccentColor">#FF0E8FA8</Color>
    <Color x:Key="AccentDeepColor">#FF076B80</Color>
    <Color x:Key="AccentGlowColor">#330E8FA8</Color>
    <Color x:Key="AccentSoftColor">#140E8FA8</Color>

    <Color x:Key="SuccessColor">#FF0F9D6E</Color>
    <Color x:Key="WarningColor">#FFC2820B</Color>
    <Color x:Key="DangerColor">#FFDC4A4A</Color>

    <Color x:Key="TrackColor">#FFE4E9F1</Color>
    <Color x:Key="ShadowColor">#FF334155</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF0876A8" Offset="0" />
        <GradientStop Color="#FF12A5BE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="MeterGradient" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#FF0F9D6E" Offset="0.0" />
        <GradientStop Color="#FF0F9D6E" Offset="0.62" />
        <GradientStop Color="#FFC2820B" Offset="0.84" />
        <GradientStop Color="#FFDC4A4A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFFAFCFE" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
