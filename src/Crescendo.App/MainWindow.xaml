<Window x:Class="Crescendo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Crescendo"
        xmlns:vm="clr-namespace:Crescendo.ViewModels"
        xmlns:views="clr-namespace:Crescendo.Views"
        Title="VolumeX"
        Icon="crescendo.ico"
        Height="760" Width="1140"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStyle="None">

    <!-- Custom chrome, but still a real Windows window: snap, Aero shake and the
         system menu all keep working because the frame is only redrawn, not
         replaced with a borderless popup. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================== title bar ==== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="crescendo.png" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="VolumeX" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <!-- Device picker: always reachable, because which device the boost
                     applies to is the one thing a user must never have to guess. -->
                <ComboBox Grid.Column="2" Style="{StaticResource FlatComboBox}"
                          ItemContainerStyle="{StaticResource FlatComboBoxItem}"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice, Mode=OneWay}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          Width="260" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                          SelectionChanged="OnDeviceSelectionChanged"
                          ToolTip="Playback device this profile applies to">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" MaxWidth="190" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimise"
                            ToolTip="Minimise" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximise"
                            ToolTip="Maximise" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================================================== body ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================ sidebar ==== -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Master switch. Given its own block at the top because it is
                         the one control that overrides everything below it. -->
                    <Border Grid.Row="0" Margin="14,16,14,10" Padding="14,12"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource OverlayBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <CheckBox Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding EngineEnabled, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{Binding EngineToggleText}" Style="{StaticResource ValueText}" />
                                <TextBlock Text="{Binding BoostText}" Style="{StaticResource CaptionText}"
                                           FontSize="11" Margin="0,1,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Grid.Row="1" Text="CONTROLS" Style="{StaticResource SectionText}"
                               Margin="26,8,0,6" />

                    <StackPanel Grid.Row="2" Margin="10,0">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Boost" Tag="&#xE995;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Boost, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Equalizer" Tag="&#xE9E9;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Equalizer, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Applications" Tag="&#xECAA;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Apps, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Devices" Tag="&#xE7F5;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Devices, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Content="Settings" Tag="&#xE713;"
                                     IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Settings, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Engine health. Kept in the chrome rather than on a page so a
                         problem is visible wherever the user happens to be. -->
                    <!-- Update banner: only present while a newer release exists. -->
                    <Border Grid.Row="3" Margin="14,10,14,0" Padding="14,12" VerticalAlignment="Top"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Update available" Style="{StaticResource ValueText}" FontSize="12.5" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdateText}" Style="{StaticResource CaptionText}"
                                       FontSize="11" Margin="0,5,0,0" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Padding="12,7"
                                    FontSize="12" Content="Update now"
                                    Command="{Binding InstallUpdateCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Margin="14,10,14,14" Padding="14,12"
                            CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource OverlayBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EngineInstalled}" Value="False">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource ValueText}" FontSize="12.5" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionText}"
                                       FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />

                            <Button Style="{StaticResource PrimaryButton}" Margin="0,11,0,0" Padding="12,7"
                                    FontSize="12" Content="Install engine"
                                    Command="{Binding InstallEngineCommand}"
                                    Visibility="{Binding EngineInstalled, Converter={StaticResource BoolToVisibilityInverse}}" />

                            <Button Style="{StaticResource SecondaryButton}" Margin="0,11,0,0" Padding="12,7"
                                    FontSize="12" Content="Restart audio service"
                                    Command="{Binding RestartAudioCommand}"
                                    Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================================================ content ==== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="32,26,32,18">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource DisplayText}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <views:BoostView Visibility="{Binding IsBoostPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:EqualizerView Visibility="{Binding IsEqualizerPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:AppsView Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:DevicesView Visibility="{Binding IsDevicesPage, Converter={StaticResource BoolToVisibility}}" />
                    <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================================================== busy veil == -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC0B0D12"
                Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BusySpin" CenterX="16" CenterY="16" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="BusySpin"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1.4" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Audio will cut out briefly." Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
