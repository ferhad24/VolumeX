<UserControl x:Class="Crescendo.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interop="clr-namespace:Crescendo.Interop">

    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="32,0,26,28">
        <StackPanel>

            <!-- ================================================= devices ==== -->
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel>
                    <TextBlock Text="PLAYBACK DEVICES" Style="{StaticResource SectionText}" Margin="14,12,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="14,0,14,10"
                               Text="Each device keeps its own profile. Headphones can sit at 300% while speakers stay untouched." />

                    <ItemsControl ItemsSource="{Binding Devices}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectDeviceCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="Transparent" Padding="14"
                                                    CornerRadius="{StaticResource ControlRadius}" Margin="0,0,0,2">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource OverlayBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                                Background="{DynamicResource OverlayBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="15" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="DEFAULT" FontFamily="{StaticResource UiFont}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Adapter}" Style="{StaticResource CaptionText}"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource ReferenceEqual}">
                                                                    <Binding Path="Id" />
                                                                    <Binding Path="DataContext.SelectedDevice.Id"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================================================== engine ==== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="AUDIO ENGINE" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                               Text="VolumeX amplifies by registering a processing object with Windows' own audio engine. It runs inside the system audio process, after mixing, which is why one instance covers every application at once." />

                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusTitle}"
                                           Style="{StaticResource ValueText}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Active device" Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedDeviceName}"
                                           Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Stream" Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusDetail}"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The honest disclosure. Deliberately not buried: this changes a
                         Windows security setting and the user should decide knowingly. -->
                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="{StaticResource ControlRadius}"
                            Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="What installing changes" Style="{StaticResource ValueText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                       Text="• Registers the VolumeX engine as a COM object and attaches it to the selected device." />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                       Text="• Allows Windows to load unsigned audio effects, which weakens the protected path used by some DRM playback." />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                       Text="• Restarts the Windows audio service once, so effects are reloaded." />
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="Anything the driver already had in that slot is saved first and put back when you remove the engine." />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Install and activate"
                                Command="{Binding InstallEngineCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Restart audio service"
                                Command="{Binding RestartAudioCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Remove completely"
                                Command="{Binding RemoveEngineCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================ effect slot ==== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="PLACEMENT" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,14"
                               Text="Where in the Windows audio graph the engine is inserted. Mode is correct for almost every driver; switch to Endpoint only if the engine never loads." />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource OptionChip}" GroupName="Slot" Content="Mode"
                                     Tag="{x:Static interop:EffectSlot.Mode}"
                                     Checked="OnSlotChecked"
                                     IsChecked="{Binding Settings.EffectSlot, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Mode, Mode=OneWay}" />
                        <RadioButton Style="{StaticResource OptionChip}" GroupName="Slot" Content="Endpoint"
                                     Tag="{x:Static interop:EffectSlot.Endpoint}"
                                     Checked="OnSlotChecked"
                                     IsChecked="{Binding Settings.EffectSlot, Converter={StaticResource EnumEquals},
                                                 ConverterParameter=Endpoint, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="Changing this needs a reinstall to take effect." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
