<UserControl x:Class="Crescendo.Views.BoostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Crescendo.Controls">

    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="32,0,26,28">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== left ==== -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">

                <!-- ================================================ dial ==== -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:BoostDial Grid.Column="0"
                                            Width="230" Height="230"
                                            Value="{Binding BoostPercent, Mode=TwoWay}"
                                            Minimum="100" Maximum="500"
                                            IsActive="{Binding EngineEnabled}"
                                            Caption="{Binding BoostGainDbText}"
                                            TrackBrush="{DynamicResource TrackBrush}"
                                            ArcBrush="{DynamicResource AccentGradient}"
                                            TextBrush="{DynamicResource TextPrimaryBrush}"
                                            SubtextBrush="{DynamicResource TextTertiaryBrush}"
                                            ToolTip="Drag up and down to set the boost. Hold Shift for fine steps, scroll to nudge." />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                            <TextBlock Text="SYSTEM BOOST" Style="{StaticResource SectionText}" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Everything Windows plays is amplified after mixing, then caught by the limiter before it reaches your speakers." />

                            <!-- The honest reading of what a percentage means, because
                                 "500%" is +14 dB, not five times the loudness. -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="GAIN" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{Binding BoostGainDbText}" Style="{StaticResource ValueText}"
                                               FontSize="16" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LIMITING" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{Binding GainReductionText}"
                                               FontSize="16" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="LATENCY" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{Binding LimiterLookaheadText}" Style="{StaticResource ValueText}"
                                               FontSize="16" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Command="{Binding ResetAllCommand}"
                                    Content="Reset this device to defaults" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================= presets ==== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="PRESET" Style="{StaticResource SectionText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,14"
                                   Text="{Binding SelectedPresetDescription}" />

                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource PresetChip}" GroupName="Preset"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.Name="{Binding Preset.Name}"
                                                 ToolTip="{Binding Preset.Description}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ================================================ tone ==== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="TONE AND IMAGING" Style="{StaticResource SectionText}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bass" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource CenteredSlider}"
                                    Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Value="{Binding BassDb, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BassText}" Style="{StaticResource ValueText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Treble" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource CenteredSlider}"
                                    Minimum="-12" Maximum="12" SmallChange="0.5" LargeChange="2"
                                    Value="{Binding TrebleDb, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding TrebleText}" Style="{StaticResource ValueText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Balance" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource CenteredSlider}"
                                    Minimum="-1" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                    Value="{Binding Balance, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BalanceText}" Style="{StaticResource ValueText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,12" Height="1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" Margin="0,0,20,0"
                                      IsChecked="{Binding MonoOutput, Mode=TwoWay}"
                                      ToolTip="Sums both channels. Useful with a single speaker or one-sided hearing.">
                                <StackPanel>
                                    <TextBlock Text="Mono output" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Fold stereo to one signal" Style="{StaticResource CaptionText}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SwapChannels, Mode=TwoWay}"
                                      ToolTip="Corrects miswired speakers or a reversed headset.">
                                <StackPanel>
                                    <TextBlock Text="Swap left / right" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Exchange the two channels" Style="{StaticResource CaptionText}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================= limiter ==== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PROTECTION" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           Text="A look-ahead limiter holds every peak under the ceiling, so boosting adds loudness instead of distortion." />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top"
                                      Margin="16,0,0,0" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" />
                        </Grid>

                        <Border Background="#22FBBF24" CornerRadius="{StaticResource RadiusSm}" Padding="12,9"
                                Margin="0,10,0,0"
                                Visibility="{Binding LimiterWarning, Converter={StaticResource PresenceToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top"
                                           Margin="0,1,9,0" />
                                <TextBlock Text="{Binding LimiterWarning}" Style="{StaticResource CaptionText}"
                                           Foreground="{DynamicResource WarningBrush}" MaxWidth="420" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,14,0,0" IsEnabled="{Binding LimiterEnabled}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ceiling" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center"
                                           ToolTip="The highest level anything may reach. -0.3 dBFS leaves headroom for the converter." />
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}"
                                        Minimum="-6" Maximum="0" SmallChange="0.1" LargeChange="0.5"
                                        Value="{Binding LimiterCeilingDb, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding LimiterCeilingText}"
                                           Style="{StaticResource ValueText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Release" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center"
                                           ToolTip="How quickly the limiter lets go. Short on speech, long on music." />
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}"
                                        Minimum="20" Maximum="500" SmallChange="5" LargeChange="25"
                                        Value="{Binding LimiterReleaseMs, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding LimiterReleaseText}"
                                           Style="{StaticResource ValueText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Look-ahead" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center"
                                           ToolTip="Delay used to see peaks coming. Longer is cleaner but adds latency." />
                                <Slider Grid.Column="1" Style="{StaticResource FlatSlider}"
                                        Minimum="1" Maximum="15" SmallChange="0.5" LargeChange="1"
                                        Value="{Binding LimiterLookaheadMs, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{Binding LimiterLookaheadText}"
                                           Style="{StaticResource ValueText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,12" Height="1" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource ToggleSwitch}" Margin="0,0,20,0"
                                      IsChecked="{Binding SoftClip, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Soft clip" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Saturate rather than cut" Style="{StaticResource CaptionText}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SubsonicFilter, Mode=TwoWay}"
                                      ToolTip="Removes inaudible sub-20 Hz energy that would otherwise eat headroom and strain small drivers.">
                                <StackPanel>
                                    <TextBlock Text="Subsonic filter" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="Cut below 20 Hz" Style="{StaticResource CaptionText}"
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- =================================================== right ==== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="18">
                <StackPanel>
                    <TextBlock Text="LEVELS" Style="{StaticResource SectionText}" />
                    <TextBlock Style="{StaticResource CaptionText}" FontSize="11" Margin="0,4,0,16"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="-60 to 0 dBFS. Input is what Windows mixed; output is what leaves VolumeX." />

                    <Grid Height="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- input pair -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LevelMeter Grid.Column="0" Value="{Binding PeakLeftIn}"
                                                 TrackBrush="{DynamicResource TrackBrush}"
                                                 FillBrush="{DynamicResource BorderStrongBrush}"
                                                 PeakBrush="{DynamicResource TextTertiaryBrush}" />
                            <controls:LevelMeter Grid.Column="2" Value="{Binding PeakRightIn}"
                                                 TrackBrush="{DynamicResource TrackBrush}"
                                                 FillBrush="{DynamicResource BorderStrongBrush}"
                                                 PeakBrush="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <!-- output pair -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:LevelMeter Grid.Column="0" Value="{Binding PeakLeft}"
                                                 TrackBrush="{DynamicResource TrackBrush}"
                                                 FillBrush="{DynamicResource MeterGradient}"
                                                 PeakBrush="{DynamicResource TextPrimaryBrush}" />
                            <controls:LevelMeter Grid.Column="2" Value="{Binding PeakRight}"
                                                 TrackBrush="{DynamicResource TrackBrush}"
                                                 FillBrush="{DynamicResource MeterGradient}"
                                                 PeakBrush="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- gain reduction, drawn downward from the top so it reads as
                             "how much is being taken away" -->
                        <controls:LevelMeter Grid.Column="4" Width="10" Value="{Binding GainReduction}"
                                             ShowPeakHold="False"
                                             TrackBrush="{DynamicResource TrackBrush}"
                                             FillBrush="{DynamicResource WarningBrush}" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IN" Style="{StaticResource SectionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="OUT" Style="{StaticResource SectionText}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="GR" Style="{StaticResource SectionText}"
                                   HorizontalAlignment="Center" Width="10" TextAlignment="Center" />
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,16,0,14" Height="1" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gain reduction" Style="{StaticResource CaptionText}" />
                        <TextBlock Grid.Column="1" Text="{Binding GainReductionText}"
                                   Style="{StaticResource ValueText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
