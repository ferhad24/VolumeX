<UserControl x:Class="Crescendo.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32,0,26,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- How this works is genuinely non-obvious, so it is explained once at
             the top rather than hidden in a tooltip. -->
        <Border Grid.Row="0" Style="{StaticResource SubtleCard}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,1,12,0" />
                <StackPanel>
                    <TextBlock Text="Per-application levels" Style="{StaticResource ValueText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0" MaxWidth="640"
                               HorizontalAlignment="Left"
                               Text="The engine runs at the loudest boost any application asks for, and Windows' own mixer brings the others back down to the right ratio. Set one app to 400% and the rest keep playing exactly as before." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing is playing" Style="{StaticResource TitleText}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,6,0,0"
                               Text="Start something with sound and it will appear here." />
                </StackPanel>

                <ScrollViewer Style="{StaticResource CleanScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Apps}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="12,14" CornerRadius="{StaticResource ControlRadius}"
                                        Margin="0,0,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- icon -->
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource OverlayBrush}" Margin="0,0,14,0">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="15" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>

                                        <!-- name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}"
                                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- level -->
                                        <Slider Grid.Column="2" Style="{StaticResource FlatSlider}"
                                                VerticalAlignment="Center"
                                                Minimum="0" Maximum="500" SmallChange="5" LargeChange="25"
                                                Value="{Binding BoostPercent, Mode=TwoWay}"
                                                IsEnabled="{Binding Muted, Converter={StaticResource InverseBool}}" />

                                        <TextBlock Grid.Column="3" Text="{Binding BoostText}"
                                                   Style="{StaticResource ValueText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="12,0,12,0" />

                                        <!-- mute -->
                                        <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center" Margin="6,0,12,0"
                                                  IsChecked="{Binding Muted, Mode=TwoWay}"
                                                  ToolTip="Mute this application" />

                                        <Button Grid.Column="5" Style="{StaticResource GhostButton}"
                                                VerticalAlignment="Center" Padding="8,6"
                                                Content="&#xE72C;" FontFamily="{StaticResource IconFont}"
                                                FontSize="12"
                                                Command="{Binding DataContext.ResetAppBoostCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Back to 100%" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
